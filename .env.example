# Postgres started by docker-compose.yml
DATABASE_URL="postgresql://app:app@localhost:5432/internal_tools?schema=public"

# Which auth provider the auth module loads at runtime.
# "mock" is the seeded, no-password provider used for local development.
# Swapping to a real IdP is intended to be a value change here plus the
# provider-specific env vars below (see lib/auth/README.md).
AUTH_PROVIDER="mock"

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="dev-only-secret-change-me-0000000000000000000000000000000000000000"

# Only read when AUTH_PROVIDER="oidc" (not implemented in this prototype).
# OIDC_ISSUER=""
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"
